{
    "name": "oc-docs",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "packageManager": "yarn@1.22.22",
    "description": "docs.ochk.io — unified documentation for the OrangeCheck ecosystem (OC Attest, OC Lock, OC Stamp, OC Vote, OC Agent).",
    "scripts": {
        "dev": "rm -rf .next && next dev",
        "predev": "node scripts/gen-doc-sources.mjs && node scripts/gen-search-index.mjs",
        "prebuild": "node scripts/gen-doc-sources.mjs && node scripts/gen-search-index.mjs",
        "build": "node scripts/gen-sitemap.mjs && next build --webpack",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "check": "yarn type-check && yarn lint && yarn format:check",
        "check:links": "node scripts/check-doc-links.mjs",
        "check:internal-links": "node scripts/check-internal-links.mjs",
        "check:kinds": "node scripts/check-kinds.mjs",
        "check:sample-imports": "node scripts/check-sample-imports.mjs",
        "pretype-check": "node scripts/ds-guard.mjs"
    },
    "dependencies": {
        "@mdx-js/loader": "^3.1.1",
        "@mdx-js/react": "^3.1.1",
        "@next/mdx": "15.5.18",
        "@orangecheck/app-design": "^1.9.0",
        "@orangecheck/auth-client": "^2.33.4",
        "@orangecheck/auth-core": "^2.9.0",
        "@orangecheck/site-kit": "^0.3.0",
        "@orangecheck/wallet-adapter": "^0.5.0",
        "@types/mdx": "^2.0.13",
        "@types/swagger-ui-react": "^5.18.0",
        "lucide-react": "^0.544.0",
        "mermaid": "^11.14.0",
        "next": "16.3.8",
        "next-themes": "^0.4.6",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "rehype-slug": "^6.0.0",
        "swagger-ui-react": "^5.32.5"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.3.8",
        "github-slugger": "^2.0.0",
        "mdast-util-to-string": "^4.0.0",
        "prettier": "^3.6.2",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "remark-gfm": "^4.0.1",
        "remark-mdx": "^3.1.1",
        "remark-parse": "^11.0.0",
        "tailwindcss": "^4",
        "typescript": "^5",
        "unified": "^11.0.5",
        "vitest": "^4.1.11"
    },
    "resolutions": {
        "js-yaml": "4.3.2"
    }
}
